# ── Kalshi API ──────────────────────────────────────────────────────────────
# Get your API key from https://kalshi.com/account/api
KALSHI_API_KEY_ID=your_api_key_id_here
KALSHI_API_KEY_SECRET=your_private_key_pem_here   # RSA private key (PEM, single line with \n)

# Use "demo" for paper trading against Kalshi's demo environment,
# or "prod" for live trading.  The bot overrides this to "demo" during the
# first PAPER_TRADING_DAYS days regardless of this setting.
KALSHI_ENV=demo

# ── Reddit API ───────────────────────────────────────────────────────────────
# Create an app at https://www.reddit.com/prefs/apps (script type)
REDDIT_CLIENT_ID=your_client_id
REDDIT_CLIENT_SECRET=your_client_secret
REDDIT_USER_AGENT=KalshiBot/1.0 by u/yourusername

# ── Trading parameters ────────────────────────────────────────────────────────
BANKROLL=500.00
MAX_BET_DOLLARS=50.00
KELLY_FRACTION=0.5           # half-Kelly
MIN_EDGE=0.04                # minimum edge (4 cents) before placing a trade
PAPER_TRADING_DAYS=7         # days of paper trading before going live

# ── Optional: Claude API for LLM probability estimation ──────────────────────
# ANTHROPIC_API_KEY=your_anthropic_api_key
