# =============================================================================
# Kalshi Trading Bot -- environment configuration
# Copy this file to .env and fill in your values.
# Lines starting with # are comments. Remove the # to enable a setting.
# =============================================================================


# -- Kalshi API (REQUIRED) ----------------------------------------------------
# Get your API key ID and RSA private key from https://kalshi.com/account/api
KALSHI_API_KEY_ID=your-api-key-uuid-here

# Paste your RSA private key on a SINGLE LINE using \n to represent newlines.
# It must include the BEGIN/END headers, e.g.:
#   -----BEGIN RSA PRIVATE KEY-----\nMIIEo...\n-----END RSA PRIVATE KEY-----
KALSHI_API_KEY_SECRET=-----BEGIN RSA PRIVATE KEY-----\nYOUR_BASE64_KEY_BODY_HERE\n-----END RSA PRIVATE KEY-----

# "demo" for paper trading against Kalshi's demo environment,
# "prod" for live trading against the real exchange.
KALSHI_ENV=demo


# -- Bankroll and core trading parameters -------------------------------------
# Set BANKROLL to your actual Kalshi account balance (or intended trading capital).
BANKROLL=500.00

# Kelly fraction: fraction of full-Kelly bet size to use (0.5 = half-Kelly).
# Lower = more conservative. Recommended: 0.5
KELLY_FRACTION=0.5

# Minimum edge required to place a trade (estimated_prob - market_price).
# Paper mode uses PAPER_MIN_EDGE (hardcoded 0.02) -- this gates live trades.
MIN_EDGE=0.04

# Maximum bet as a fraction of current bankroll (default 15%).
# Caps Kelly sizing before the hard cap below applies.
MAX_BET_PCT_BANKROLL=0.15

# Hard dollar cap on any single bet regardless of Kelly or bankroll.
# Set lower during early live trading to limit per-trade risk.
MAX_BET_HARD_CAP=25.00

# Minimum bet in dollars -- trades sized below this by Kelly are skipped.
MIN_BET_DOLLARS=2.00

# Maximum fraction of notional bankroll deployed in a single ticker (default 25%).
# Prevents runaway concentration on one market. Set to 1.0 to disable.
MAX_TICKER_EXPOSURE_PCT=0.25


# -- Live trading kill-switch -------------------------------------------------
# Hard gate that must be explicitly set before live trading is allowed.
# When false (default): --go-live is refused and any go_live_confirmed flag in the
# DB is ignored -- the bot stays in paper mode regardless.
# When true: --go-live proceeds normally and the DB flag is honoured at startup.
#
# Policy: do NOT set to true until Mac Studio hardware is in place, or until an
# explicit request is made with stated goals and expected costs.
LIVE_TRADING_ENABLED=false

# Live session loss limit: halt all trading if the Kalshi account balance drops more
# than this fraction of BANKROLL below the session-start balance. Default 10%.
# Set to 1.0 to disable. Only active in live mode.
LIVE_LOSS_LIMIT_PERCENT=0.10


# -- Go-live readiness gates --------------------------------------------------
# Evaluated when you run `python main.py --go-live`.
# All gates must pass before the CONFIRM prompt appears.
# Override individual gates here only if you intentionally want to bypass them.
#
# GO_LIVE_MIN_RESOLVED=20        # minimum resolved paper trades required
# GO_LIVE_MIN_WIN_RATE=0.52      # minimum win rate on resolved trades
# GO_LIVE_MAX_DRAWDOWN_PCT=0.20  # max drawdown as fraction of starting bankroll


# -- LLM probability estimation (choose one or both) -------------------------
#
# OPTION A -- Local Ollama (FREE, recommended for self-hosted 24/7 use)
#   Install:    https://ollama.com/download/windows
#   Pull model: ollama pull qwen2.5:7b
#   Defaults are correct for localhost -- only set these to override.
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen2.5:7b
#
# OPTION B -- Anthropic Claude Haiku (PAID, higher accuracy)
#   Get key: https://console.anthropic.com -> API Keys
# ANTHROPIC_API_KEY=sk-ant-your-key-here
#
# Priority: Ollama (if running) -> Anthropic (if key set) -> keyword-only fallback
# Both can be set: Ollama handles normal load, Anthropic falls back if Ollama is down.


# -- Reddit API (optional, highly recommended) --------------------------------
# Without these the bot uses Reddit's public JSON API which is aggressively
# rate-limited and IP-blocked (~2,600 HTTP 403s/week observed).
# With OAuth2 you get 600 requests per 10 minutes -- effectively unlimited
# for this bot's polling pattern.
#
# Create an app at https://www.reddit.com/prefs/apps (select "script" type).
# The redirect URI can be http://localhost -- it is not used for this grant type.
# REDDIT_CLIENT_ID=your-14-char-client-id
# REDDIT_CLIENT_SECRET=your-27-char-client-secret
# REDDIT_USER_AGENT=KalshiBot/1.0 (by /u/your-reddit-username)


# -- Fade tweet signal (optional) ---------------------------------------------
# When prediction-market accounts tweet "BREAKING" or "odds at all-time high",
# retail attention overprices the market. This signal fades the hype (buys NO).
#
# Comma-separated RSSHub feed URLs (one per account to monitor).
# Use public RSSHub for paper trading; self-host before going live
# (public instance may be rate-limited or blocked by X).
#
# Recommended accounts: @Kalshi, @Polymarket, @DecisionDeskHQ
# FADE_TWEET_FEED_URLS=https://rsshub.app/twitter/user/Kalshi,https://rsshub.app/twitter/user/Polymarket

# Price thresholds for the fade-tweet signal (cents out of 100).
# Markets above HIGH or below LOW are considered extreme and eligible for fading.
# FADE_PRICE_HIGH_THRESHOLD=85
# FADE_PRICE_LOW_THRESHOLD=15


# -- Advanced signal tuning (defaults are good -- change only if needed) ------

# Maximum age of a news item when the consumer processes it (seconds).
# Items older than this are skipped -- they are already priced in.
# MAX_NEWS_AGE_SECONDS=300

# Early intake pre-filter: drop stale items before they enter the queue/matching path.
# EARLY_MAX_NEWS_AGE_SECONDS=300

# Drop feed items that arrive with no valid timestamp (before enqueueing).
# EARLY_DROP_IF_NO_TIMESTAMP=true

# Time-value discount for market time-to-expiry (Kelly sizing multiplier).
# Half-life in days: after this many days, edge is discounted by 50%.
# Floor: minimum multiplier regardless of expiry distance.
# TIME_DISCOUNT_HALF_LIFE=14.0
# TIME_DISCOUNT_FLOOR=0.20

# Ticker cooldowns: minimum seconds between trades on the same ticker.
# PAPER_TICKER_COOLDOWN=14400   # 4 hours (paper mode)
# LIVE_TICKER_COOLDOWN=600      # 10 minutes (live mode)

# WebSocket price drift alert: log a WARNING when estimated_prob vs WS mid-price
# drifts more than this many cents, at most once per cooldown window.
# DRIFT_ALERT_CENTS=15
# DRIFT_LOG_COOLDOWN_SECS=3600

# Price velocity signal: trigger a targeted news search when a ticker moves more
# than THRESHOLD cents within WINDOW seconds. COOLDOWN prevents search spam.
# PRICE_MOVE_THRESHOLD_CENTS=10
# PRICE_SEARCH_COOLDOWN_SECS=1800
# PRICE_VELOCITY_WINDOW_SECS=300

# Source stats pruning thresholds (used in daily report flagging).
# SOURCE_STATS_MIN_POSTS=100
# SOURCE_STATS_LOW_SIGNAL_RATE=0.005
# SOURCE_STATS_ZERO_SIGNAL_POSTS=200

# Subreddit discovery: how often to scan for new geopolitical subreddits.
# SUBREDDIT_DISCOVERY_INTERVAL_SECS=21600   # 6 hours between full passes
# SUBREDDIT_PROBE_COOLDOWN_SECS=10800       # 3 hours before re-probing a candidate
# SUBREDDIT_PROBE_SLOTS=3                   # candidates probed per poll cycle
# SUBREDDIT_DISCOVERY_MAX_QUERIES=10        # queries per discovery pass
