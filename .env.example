# Names the process reads. Placeholders only. Secrets stay empty.
# Research profiles: docs/governance/research-shadow.env.example and docs/governance/research-production-paper.env.example.
XAI_API_KEY=  # xAI key for paper Grok. A missing key fail-closes a paid call.
KALSHI_API_KEY_ID=  # Kalshi API key id.
KALSHI_API_KEY_SECRET=  # RSA PEM on one line with literal backslash-n. Never commit a real key.
KALSHI_ENV=demo  # demo or prod.
ENABLE_WEATHER_SHADOW_CAPTURE=false  # Optional. Unset uses the code default.
POLYMARKET_US_ENABLED=false  # Second venue. Stays false.
POLYMARKET_US_KEY_ID=  # Polymarket key id. Leave empty.
POLYMARKET_US_SECRET=  # Polymarket secret. Leave empty.
POLYMARKET_US_PUBLIC_BASE_URL=https://gateway.polymarket.us  # Optional. Unset uses the code default.
POLYMARKET_US_API_BASE_URL=https://api.polymarket.us  # Optional. Unset uses the code default.
POLYMARKET_US_LIVE_TRADING_ENABLED=false  # Second venue live switch. Stays false.
POLYMARKET_US_PUBLIC_REQUESTS_PER_SECOND=20  # Optional. Unset uses the code default.
