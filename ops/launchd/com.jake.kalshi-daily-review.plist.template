<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jake.kalshi-daily-review</string>

    <key>ProgramArguments</key>
    <array>
        <string>@VENV_PYTHON@</string>
        <string>@REPO_ROOT@/scripts/daily_review.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>@REPO_ROOT@</string>

    <!-- Daily 09:00 America/Denver. Runs one hour after bothealth so the
         operator's morning has two distinct push surfaces: bothealth (fast
         RED/YELLOW/GREEN verdict + osascript toast) and daily_review
         (full pipeline funnel + section-0 SYSTEM HEALTH + scorecard).
         Like bothealth, this plist does NOT self-clean -- it keeps firing
         forever until the operator removes it. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>@REPO_ROOT@/logs/app/daily_review_launchd.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>@REPO_ROOT@/logs/app/daily_review_launchd.stderr.log</string>
</dict>
</plist>
