<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jake.kalshi-bothealth</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>@REPO_ROOT@/scripts/bothealth.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>@REPO_ROOT@</string>

    <!-- Daily 08:00 America/Denver. Unlike soak-check / midsoak this plist
         does NOT self-clean — it is meant to keep firing forever until the
         operator removes it. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>@REPO_ROOT@/logs/app/bothealth_launchd.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>@REPO_ROOT@/logs/app/bothealth_launchd.stderr.log</string>
</dict>
</plist>
