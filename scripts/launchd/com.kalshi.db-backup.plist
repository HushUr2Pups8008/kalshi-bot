<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.kalshi.db-backup</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/jacobparenti/vscode/kalshi-bot/scripts/db_snapshot_backup.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/jacobparenti/vscode/kalshi-bot</string>

    <!-- Run daily at 06:00 LOCAL time. macOS launchd uses local time for
         StartCalendarInterval. In May NZST (UTC+12), 06:00 NZ = 18:00 UTC
         the previous day, which is well outside the bot's high-activity
         window (US news cycles 13:00-15:00 UTC and 21:00-23:00 UTC) and
         after the governance deep cycle settles. Adjust Hour/Minute if
         operator timezone differs. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- Also run once at LaunchAgent load so first install seeds the
         archive immediately without waiting up to 24 h for the next
         scheduled fire. -->
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/jacobparenti/vscode/kalshi-bot/logs/app/db-backup.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/jacobparenti/vscode/kalshi-bot/logs/app/db-backup.stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
