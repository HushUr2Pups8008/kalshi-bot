# Environment / secrets
.env

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
*.egg-info/
dist/
build/

# Bot data (paper trades DB, logs -- too large/personal for version control)
data/*.db
data/*.db-journal
data/*.lock
data/*.pid
logs/*.log
logs/*.log.*
logs/app/
logs/reports/
logs/trades/
logs/service/

# Test temp directories
tests/_tmp_*/
tests/_tmp_*.jsonl

# Keep the placeholder files
!data/.gitkeep
!logs/.gitkeep

# Windows historical archive (extracted from transfer/*.tar.gz)
# The tarball in transfer/ is the canonical git-tracked copy.
# Extracted data and log files are large (~80 MB) and excluded here.
# To re-populate: tar -xzf transfer/decision-support-sync-2026-04-18.tar.gz -C archive/windows-2026-04-18/
archive/windows-2026-04-18/data/
archive/windows-2026-04-18/logs/
# Keep the provenance marker committed
!archive/windows-2026-04-18/PROVENANCE.md

# PAT / credential files
*_pat.txt
JRP_GamingDesktop_pat.txt

# macOS
.DS_Store

# Windows
Thumbs.db

# Machine-specific Windows setup files (paths, service config, credentials)
WINDOWS_COMMANDS.md
setup_service.ps1

# IDE
.vscode/
.idea/
