# Environment / secrets
.env

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
*.egg-info/
dist/
build/

# Bot data (paper trades DB, logs -- too large/personal for version control)
data/*.db
data/*.db-journal
data/*.db-shm
data/*.db-wal
data/*.lock
data/*.pid
logs/*.log
logs/*.log.*
logs/app/
logs/reports/
logs/trades/
logs/service/
logs/tests/
logs/governance/

# Test temp directories
tests/_tmp_*/
tests/_tmp_*.jsonl

# Coverage artifacts (regenerate via `pytest --cov`)
.coverage
.coverage.*
htmlcov/
coverage.xml
# Coverage run logs are untracked by default; commit specific dated
# snapshots explicitly with `git add -f logs/coverage/<name>.log` to
# preserve a point-in-time baseline. Already-committed snapshots stay
# tracked; only new files created by `make coverage` are ignored.
logs/coverage/

# Keep the placeholder files
!data/.gitkeep
!logs/.gitkeep

# Windows historical archive: raw imported data + derived analysis layer
# Bulk raw data (logs, DB) and derived artifacts (trades_all.jsonl, bot_all.log, etc.)
# are excluded from git -- the tarball in transfer/ is the canonical committed copy.
# Re-extract raw: tar -xzf transfer/decision-support-sync-2026-04-18.tar.gz \
#                     -C windows_archive/raw/2026-04-18_import/
windows_archive/raw/2026-04-18_import/data/
windows_archive/raw/2026-04-18_import/logs/
# Bulk derived artifacts -- large, re-derivable; not committed
# (git cannot un-ignore files inside an ignored directory, so we exclude
#  specific files rather than the whole analysis/ tree)
windows_archive/analysis/2026-04-18_import/consolidated/trades_all.jsonl
windows_archive/analysis/2026-04-18_import/consolidated/trades_all.jsonl.gz
windows_archive/analysis/2026-04-18_import/consolidated/bot_all.log
windows_archive/analysis/2026-04-18_import/consolidated/bot_all.log.gz
windows_archive/analysis/2026-04-18_import/db/
# README, PROVENANCE.md, manifest.json, and notes.md are NOT listed above
# and will be committed as the durable provenance record

# MacBook -> Mac Studio handoff (2026-05-01): extracted logs from the tarball
# in transfer/macbook_handoff_2026-05-01/ live here. Same pattern as the windows
# archive above -- the tarball is canonical, the extracted tree is re-derivable.
# Re-extract: ./scripts/restore_macbook_handoff.sh --extract-logs
mac_archive/macbook_2026-05-01_import/

# PAT / credential files
*_pat.txt
JRP_GamingDesktop_pat.txt

