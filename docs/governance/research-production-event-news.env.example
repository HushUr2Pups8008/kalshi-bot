# Research production activation profile for the non-sports event-news paper cohort.
#
# This is the politics money-path contract. Live trading stays locked.
# Separate from the macro/DJI freeze profile so botcheck cannot report a
# false activation mismatch after an intentional cohort change.
#
# Polymarket US stays disabled: retail KYC is waitlist-gated and live
# trading on that venue is a separate high-assurance enable. Do not flip
# POLYMARKET_US_ENABLED here.

REAL_WEB_RESEARCH_MODE=production
GENERIC_SEARCH_CIRCUIT_MODE=enforce
REAL_WEB_RESEARCH_MAX_QUERIES=10
REAL_WEB_RESEARCH_TIMEOUT_SECONDS=18.0
RESEARCH_EVENT_SEARCH_PROVIDER_ORDER=legacy

KALSHI_MACRO_ONLY=false
RESEARCH_PREWARM_SCOPE=non_sports_shadow
RESEARCH_PREWARM_DESK=inherit
POLYMARKET_US_ENABLED=false
POLYMARKET_US_LIVE_TRADING_ENABLED=false
REDDIT_ENABLED=false
FADE_TWEET_FEED_URLS=

# Invert cheap-contract bias. LLM + keyword fallback must not trade longshots.
ENABLE_LLM_ROUTING_FILTER=true
LLM_ALLOWED_PRICE_BANDS=0.55-0.99
LLM_EXCLUDED_PRICE_BANDS=0.00-0.35

# Favorite-band official prewarm. Isolated from the DJI freeze process.
ENABLE_RESEARCH_PREWARM_TASK=true
ENABLE_FEE_NET_PAPER_ACCOUNTING=true
RESEARCH_PREWARM_INTERVAL_SECONDS=300
RESEARCH_PREWARM_MAX_MARKETS=25
RESEARCH_PREWARM_CONCURRENCY=2
RESEARCH_PREWARM_MAX_PAGES=5
RESEARCH_PREWARM_SOURCEABLE_SERIES_FALLBACK=KXTRUTHSOCIAL
RESEARCH_PREWARM_TARGET_COOLDOWN_SECONDS=300
# Empty: do not inherit freeze KXDJI forecast-refresh.
RESEARCH_PREWARM_FORECAST_REFRESH_SERIES=

PAPER_COHORT_ID=kalshi-event-news-20260820
PAPER_COHORT_KIND=active
PAPER_ACTIVE_COHORT_BANKROLL=50.00
PAPER_ACTIVE_COHORT_MAX_DAYS_TO_CLOSE=14

LIVE_TRADING_ENABLED=false
ENABLE_CANONICAL_PERSISTED_SETTLEMENT_RECONCILIATION=true
KELLY_FRACTION=0.5
MIN_EDGE=0.04
MAX_BET_PCT_BANKROLL=0.15
MAX_BET_HARD_CAP=25.00
MIN_BET_DOLLARS=2.00
MAX_TICKER_EXPOSURE_PCT=0.25

# Politics matcher coverage. Default 24 series yielded 6 open markets.
KALSHI_MATCHER_SERIES_LIMIT=200
# Do not inherit freeze google_news_query disable on this desk.
DISABLED_SOURCE_FAMILIES_EXTRA=
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_KEEP_ALIVE=-1
LLM_MAX_CONCURRENT=4
NEWS_CONSUMER_WORKERS=4

# Killed / shadow lanes stay off on this desk.
ENABLE_WEATHER_SHADOW_CAPTURE=false
ENABLE_NEWS_EDGE_PRIORITIZATION=false
ENABLE_MARKET_FIRST_QUERY_SHADOW=false
MARKET_SOURCE_HINTS_QUERY_MODE=off
ENABLE_MARKET_SOURCE_HINT_SHADOW_CAPTURE=false
ENABLE_FRESH_PASS_ASSIGNMENT_SHADOW=false
ENABLE_G7_SKIP_EVIDENCE_CAPTURE=false
ENABLE_CAPITAL_GUARD_SHADOW_CAPTURE=false
ENABLE_CAPITAL_GUARD_SHADOW_SETTLEMENT_COLLECTION=false
ENABLE_PRE_LLM_MATCH_GATE=false
