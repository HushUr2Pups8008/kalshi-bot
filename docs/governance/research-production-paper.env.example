# Research production activation profile for paper trading.
#
# Purpose: stop terminal neutral/no-keyword skips when the research gate finds
# settlement-aligned evidence and edge, while keeping live trading locked. Copy
# these lines into .env only after shadow evidence satisfies
# scripts/research_rollout_gate.py for the deployed VERSION. Before restart,
# verify .env with:
#   python scripts/research_activation_status.py --profile docs/governance/research-production-paper.env.example

REAL_WEB_RESEARCH_MODE=production
REAL_WEB_RESEARCH_MAX_QUERIES=6
REAL_WEB_RESEARCH_TIMEOUT_SECONDS=12.0

ENABLE_RESEARCH_PREWARM_TASK=true
RESEARCH_PREWARM_INTERVAL_SECONDS=300
RESEARCH_PREWARM_MAX_MARKETS=25
RESEARCH_PREWARM_MAX_PAGES=5
RESEARCH_PREWARM_TARGET_COOLDOWN_SECONDS=1800

# This profile may change paper-trade admission, but must not unlock live orders.
LIVE_TRADING_ENABLED=false
