# Research shadow activation profile.
#
# Purpose: start collecting durable web-research dossiers and prewarm likely
# information-gap markets without promoting neutral/no-keyword candidates into
# trades. Before restart, verify .env with:
#   python scripts/research_activation_status.py --profile docs/governance/research-shadow.env.example
# After restart, run scripts/research_rollout_gate.py with the deployed VERSION
# before escalation.

REAL_WEB_RESEARCH_MODE=shadow
REAL_WEB_RESEARCH_MAX_QUERIES=6
REAL_WEB_RESEARCH_TIMEOUT_SECONDS=12.0

ENABLE_RESEARCH_PREWARM_TASK=true
RESEARCH_PREWARM_INTERVAL_SECONDS=300
RESEARCH_PREWARM_MAX_MARKETS=25
RESEARCH_PREWARM_MAX_PAGES=5
RESEARCH_PREWARM_SOURCEABLE_SERIES_FALLBACK=KXGDP,KXCPI,KXFED,KXNASDAQ100,KXBTC,KXETH,KXHIGHNY,KXMLB,KXNBA
RESEARCH_PREWARM_TARGET_COOLDOWN_SECONDS=1800

# Shadow profile must not unlock live orders.
LIVE_TRADING_ENABLED=false
