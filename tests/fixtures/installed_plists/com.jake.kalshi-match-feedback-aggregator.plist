<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jake.kalshi-match-feedback-aggregator</string>

    <key>ProgramArguments</key>
    <array>
        <string>@VENV_PYTHON@</string>
        <string>-m</string>
        <string>scripts.match_feedback_aggregator</string>
    </array>

    <key>WorkingDirectory</key>
    <string>@REPO_ROOT@</string>

    <!-- PROFIT-MATCH-DYNAMIC commit 5/5: daily aggregator runs at 08:55
         America/Denver, 5 minutes before daily_review (09:00) so the
         operator's morning surface includes fresh weights. Like the other
         non-self-cleaning crons (bothealth, daily-review), this fires
         forever until removed. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>55</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>@REPO_ROOT@/logs/app/match_feedback_aggregator_launchd.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>@REPO_ROOT@/logs/app/match_feedback_aggregator_launchd.stderr.log</string>
</dict>
</plist>
